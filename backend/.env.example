# Model to serve. Either a Hugging Face Hub repo id (downloaded at boot) or a
# local path to a saved model directory (e.g. ../ml/artifacts/emotion-distilbert).
MODEL_REPO=yourusername/emotion-distilbert

# Comma-separated list of browser origins allowed to call this API.
ALLOWED_ORIGIN=https://emotionsense.vercel.app,http://localhost:3000

# Optional: HF token, only if MODEL_REPO points at a private repo.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Requests per minute, per IP, on the prediction endpoints.
RATE_LIMIT=60/minute

# Max characters accepted in a single prediction request.
MAX_TEXT_LENGTH=1000

# Max items accepted in one batch request.
MAX_BATCH_SIZE=200

# Set to "false" in production if you want to hide the interactive docs.
ENABLE_DOCS=true
